# Desktop OAuth client secret for Nova's existing Desktop app client ID.
# Copy to .env.local before building Windows or macOS. Never use a Web client.
NOVA_GOOGLE_CLIENT_SECRET=

# Optional, only for iOS builds (same Google Cloud project as desktop).
NOVA_GOOGLE_IOS_CLIENT_ID=

# Optional, only for the Vercel/browser build. Public Web OAuth client ID, not a secret.
VITE_GOOGLE_WEB_CLIENT_ID=
