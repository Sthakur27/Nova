{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nova",
  "version": "0.2.0",
  "identifier": "com.nova.notes.prototype",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Nova",
        "width": 1320,
        "height": 880,
        "minWidth": 800,
        "minHeight": 550,
        "transparent": true,
        "backgroundColor": "#00000000",
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "Entitlements.plist",
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZDRDhENjVCMTk2MkM1QTMKUldTanhXSVpXOWJZYkxNbVJZUkR2R3pVbDhyVDVKYm9Yc0wzV2x2V1BwSGxhNE9VZ0pQbm9HdXkK",
      "endpoints": [
        "https://github.com/Sthakur27/Nova/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
